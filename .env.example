# Copie para .env.local e preencha.
# .env.local é ignorado pelo git — nunca versione chaves.

# Desenvolvimento: os valores aparecem no terminal ao rodar `npx supabase start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Produção: URL e chave anon do projeto (VPS ou Supabase gerenciado).
# A chave anon é pública por design — quem protege os dados é o RLS.
# A service_role NUNCA vai para cá: ela só existe nos segredos das edge functions.
