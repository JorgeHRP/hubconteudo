# =====================================================================
# Central Interna — o que não vai para o git
# =====================================================================
# Regra geral: segredo, arquivo gerado e coisa pessoal de cada máquina ficam
# fora. A documentação do projeto (README.md e docs/) continua versionada.

# ---------------------------------------------------------------------
# Segredos e variáveis de ambiente
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.local.*
senha*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credenciais*
credentials*
secrets*
service-account*.json
*-sa.json

# Supabase: segredos das funções e arquivos da CLI
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/.temp/
supabase/.branches/
supabase/.supabase/

# Gerados a partir de supabase/migrations e supabase/functions, para colar no painel
supabase/colar-*

# Cópias e exportações de banco (podem ter dado real de cliente)
*.dump
*.backup
*.bak
backup*/
backups/
dump*.sql
*.sqlite
*.sqlite3
*.db

